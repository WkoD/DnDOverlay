<Project Sdk="Microsoft.NET.Sdk">

  <!-- THE GENERATOR - not a test project. It writes images, bombs and token containers into
       a directory handed to it, and carries the assembly fixture. Two test projects need
       the same files: the format parcours and the folder reconciliation in Campaign.Tests
       (Part 2).

       It references Magick.NET DIRECTLY rather than going through our own codec: its
       purpose is WRITING formats, and the statement "what the build can write it can also
       read" hangs on exactly that. Both must carry the same package variant, otherwise the
       same ImageMagick types would appear twice in one compilation of Imaging.Tests. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Magick.NET-Q8-AnyCPU" />
  </ItemGroup>

  <!-- The ONE thing it takes from src/: the coder policy, which the fixture has to apply before
       the first generated file (Part 5). The policy is process-wide ImageMagick state, not our
       codec - "not through Imaging" above is said about WRITING formats, and that is unchanged:
       every image below is written straight through Magick.NET.

       Keeping the policy here instead would be a second copy of the one decision that must not
       have one; handing it in per test project would turn the guarantee into a wiring convention
       that fails silently when somebody forgets it. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\DnDOverlay.Imaging\DnDOverlay.Imaging.csproj" />
  </ItemGroup>

</Project>
