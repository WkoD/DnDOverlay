<Project>

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!-- Every test runs in English, whatever the machine speaks: the texts compared are the neutral
       ones, and a German Windows must not turn a passing suite red that passes in CI. Tests about
       German ask for it by name (Part 8). -->
  <ItemGroup>
    <Content Include="$(MSBuildThisFileDirectory)xunit.runner.json" Link="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
