    <PackageReference Include="Microsoft.NET.Test.Sdk" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DnDOverlay.Campaign\DnDOverlay.Campaign.csproj" />
    <ProjectReference Include="..\DnDOverlay.TestData\DnDOverlay.TestData.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
