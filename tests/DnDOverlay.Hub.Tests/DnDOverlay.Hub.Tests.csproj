<Project Sdk="Microsoft.NET.Sdk">

  <!-- ISessionApi, SceneStore, pairing, send queues. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <!-- The running thread is tested over a REAL socket against a real Kestrel, not against a
         mocked pipeline: what M1a has to prove is that a command reaches a display, and an
         in-memory shortcut would prove the shortcut. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DnDOverlay.Hub\DnDOverlay.Hub.csproj" />

    <!-- The OTHER side of the wire, and it is here for one reason: the seam.
         A test project reaches into its own subject as a matter of course; reaching into a second
         one is a decision, and this is what paid for it. The asset endpoint gained a token
         requirement, AssetClient knew nothing about it, and BOTH test suites stayed green - each
         brings its own counterpart, so neither ever met the other. The display fetched nothing for
         a whole commit, and it looked like an ordinary failed download.

         Transport does not reference the hub and must not: the client has no business knowing what
         serves it. So the seam test lives on this side. A stub of the endpoint inside
         Transport.Tests would be worthless - it would prove the client SENDS a header, not that
         the hub ACCEPTS it. -->
    <ProjectReference Include="..\..\src\DnDOverlay.Transport\DnDOverlay.Transport.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The same hand-written clock the configuration tests use, linked rather than copied.
         Without it the rate limit could only be tested in the direction that refuses - and the
         direction that matters more is the one that lets go again: an unpaired display on weak
         Wi-Fi reaches twenty attempts by itself, and a window that never resets would lock it
         out for good (Part 4). One shared file beats a second implementation that drifts. -->
    <Compile Include="..\DnDOverlay.Core.Tests\Configuration\ManualTime.cs" Link="ManualTime.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
