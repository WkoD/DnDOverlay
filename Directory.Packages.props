<Project>

  <!-- Central Package Management: every NuGet version lives here exactly once. -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="Build">
    <PackageVersion Include="MinVer" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup Label="Logging">
    <!-- Logging goes through ILogger, never through a sink directly - that is what keeps the
         sink exchangeable (Part 1, rule 8; Part 8). The hub gets these abstractions through the
         ASP.NET Core framework reference; Transport, Campaign and Imaging need the package. -->
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <!-- The generic host with DI for the display. The control gets the same thing through the
         ASP.NET Core framework reference it needs for Kestrel anyway (Part 2). -->
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup Label="Platform">
    <!-- DPAPI. Out of band, so it needs a package even on a Windows target framework - and it is
         referenced by exactly one project, DnDOverlay.Platform.Windows. The architecture test
         forbids this assembly in all five libraries by name: pairing is hub business, and a
         ProtectedData there would compile without a murmur (Part 4, Part 11). -->
    <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup Label="Imaging">
    <!-- AnyCPU, not x64: the x64 variant carries Windows natives only, which would make
         DnDOverlay.Imaging Windows-bound although it targets net10.0 (Part 5). The native
         binary is identical, and a self-contained publish is RID specific, so the MSI does
         not grow. Imaging and the test data generator must reference the same variant. -->
    <PackageVersion Include="Magick.NET-Q8-AnyCPU" Version="14.16.0" />

    <!-- GIF animation: frames, frame times and the disposal handling that goes with them. Behind
         our own abstraction (rule 8), so what depends on it is one type in Rendering.Windows.
         Measured before it was pinned: 2.0.2 restores and builds against net10.0-windows. -->
    <PackageVersion Include="WpfAnimatedGif" Version="2.0.2" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <PackageVersion Include="xunit.v3" Version="4.0.0" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageVersion Include="TngTech.ArchUnitNET" Version="0.13.4" />
    <PackageVersion Include="TngTech.ArchUnitNET.xUnitV3" Version="0.13.4" />
    <!-- ArchUnitNET reads assemblies with Cecil anyway. We use it directly for the rules it
         cannot phrase: DateTime.Now is a CALL, not a dependency - forbidding the type
         System.DateTime would also forbid every legitimate use of it (Part 11). -->
    <PackageVersion Include="Mono.Cecil" Version="0.11.6" />
  </ItemGroup>

</Project>
