<Project>

  <!-- Central Package Management: every NuGet version lives here exactly once. -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="Build">
    <PackageVersion Include="MinVer" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup Label="Imaging">
    <!-- AnyCPU, not x64: the x64 variant carries Windows natives only, which would make
         DnDOverlay.Imaging Windows-bound although it targets net10.0 (Part 5). The native
         binary is identical, and a self-contained publish is RID specific, so the MSI does
         not grow. Imaging and the test data generator must reference the same variant. -->
    <PackageVersion Include="Magick.NET-Q8-AnyCPU" Version="14.16.0" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageVersion Include="TngTech.ArchUnitNET" Version="0.13.3" />
    <PackageVersion Include="TngTech.ArchUnitNET.xUnitV3" Version="0.13.3" />
    <!-- ArchUnitNET reads assemblies with Cecil anyway. We use it directly for the rules it
         cannot phrase: DateTime.Now is a CALL, not a dependency - forbidding the type
         System.DateTime would also forbid every legitimate use of it (Part 11). -->
    <PackageVersion Include="Mono.Cecil" Version="0.11.6" />
  </ItemGroup>

</Project>
