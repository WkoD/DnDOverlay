{
  "version": "0.2.0",

  // Control and Display run side by side on the development machine - that is a regular
  // arrangement, not a special mode (Part 2). Both get --data dev-data so a test run never
  // touches the regularly installed copy on the same machine: configuration, campaigns,
  // image cache and logs all move into the project (Part 9). dev-data/ is git-ignored.
  //
  // NO --windowed anywhere any more, on purpose. The hand runs are what these entries are for,
  // and half of what they have to show only exists on a real overlay: identify, the rescue mark,
  // transparency over MapTool, the blackout curtain. Windowed mode is itself a per-screen display
  // parameter (Part 6) and is switched THERE when it is what is being tested - the start argument
  // was only ever the quick way to it.
  //
  // The installed Control has to be closed: the single-instance mutex does not allow a
  // second one, it brings the running window to the front.
  //
  // THE COMPOUND BUILDS ONCE, AND THAT IS ALL THE FOUR ENTRIES BELOW ARE FOR.
  // A preLaunchTask on both members would run the build twice per F5. The compound therefore
  // builds the whole solution once, up front, and launches two configurations that build nothing
  // themselves; those two are hidden from the dropdown. It may build the solution because it also
  // STOPS both - nothing of ours is running while it builds.
  //
  // THE TWO VISIBLE ENTRIES BUILD THEIR OWN PROJECT, NOT THE SOLUTION, AND THAT IS A FIX.
  // They used to build the solution too, on the measured grounds that an incremental build with
  // nothing to do rewrites no output file and so never meets a file the running process holds.
  // That assumption is true only while the other application's output folder is IN SYNC - and it
  // is self-perpetuating once it is not: starting the Display built the Control as well, the copy
  // into the Control's output could not happen because the Control was running, the task ended
  // with exit code 1, and VS Code refused to start a Display that had just built perfectly well.
  // The way out was to stop the Control and build once - which is the opposite of what the entry
  // is for. Measured on the second machine in M1c; on the first the folder happened to be in sync
  // and it never showed.
  //
  // A project build only ever writes into its own output, so the two can no longer collide. What
  // it costs is that starting one application no longer compiles the other - which is right: the
  // other one is not being restarted either.
  //
  // THE COMPOUND STOPS BOTH - "stopAll": true, and it stays that way. It cost two false findings
  // in one evening: a hand run where the display "was not running any more", and a control that
  // seemed to die with exit code -1 when the display was stopped. Neither was real.
  //
  // It stays because the alternative is worse: without it, stopping one session leaves the other
  // running, and a stray control keeps port 47800 - so the next F5 meets a taken port instead.
  //
  // WHAT FOLLOWS FROM IT: a hand run that has to stop ONE process - "stop the control, mangle the
  // configuration, start it again" - uses the two visible entries as separate sessions, never the
  // compound. The proof that the other one really is still alive is its log: after a control
  // restart a live display writes 1042 RetryingIn. Without that line the run proves nothing.

  "configurations": [
    {
      "name": "Control",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build control",
      "program": "${workspaceFolder}/src/DnDOverlay.Control/bin/Debug/net10.0-windows/DnDOverlay.Control.exe",
      "args": ["--data", "dev-data"],
      "cwd": "${workspaceFolder}",
      "console": "internalConsole",
      "stopAtEntry": false
    },
    {
      "name": "Display",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build display",
      "program": "${workspaceFolder}/src/DnDOverlay.Display/bin/Debug/net10.0-windows/DnDOverlay.Display.exe",
      "args": ["--data", "dev-data"],
      "cwd": "${workspaceFolder}",
      "console": "internalConsole",
      "stopAtEntry": false
    },

    // Members of the compound. Identical to the two above except that they build nothing -
    // the compound has already done it. Hidden, so the dropdown keeps offering three choices.
    {
      "name": "Control (compound member)",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/src/DnDOverlay.Control/bin/Debug/net10.0-windows/DnDOverlay.Control.exe",
      "args": ["--data", "dev-data"],
      "cwd": "${workspaceFolder}",
      "console": "internalConsole",
      "stopAtEntry": false,
      "presentation": { "hidden": true }
    },
    {
      "name": "Display (compound member)",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/src/DnDOverlay.Display/bin/Debug/net10.0-windows/DnDOverlay.Display.exe",
      "args": ["--data", "dev-data"],
      "cwd": "${workspaceFolder}",
      "console": "internalConsole",
      "stopAtEntry": false,
      "presentation": { "hidden": true }
    }
  ],

  // The everyday case. The single configurations above exist for the two-machine run in
  // M1c, where each machine carries only one role.
  //
  // The Control is listed first on purpose: the Display connects once and gives up when it
  // fails - the reconnect backoff is M1b (DisplayClient). Should it still lose the race, the
  // remedy is to restart the Display alone; the console says "ConnectFailed".
  "compounds": [
    {
      "name": "Control + Display",
      "preLaunchTask": "build",
      "configurations": ["Control (compound member)", "Display (compound member)"],
      "stopAll": true
    }
  ]
}
