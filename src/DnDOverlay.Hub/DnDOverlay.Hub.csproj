<Project Sdk="Microsoft.NET.Sdk">

  <!-- Kestrel, the WebSocket endpoints and their send queues, ISessionApi, SceneStore,
       discovery beacon, pairing. It owns the arrangement and nothing else - it does not
       know the campaign folder and reaches assets only through IAssetSource (Part 2). -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DnDOverlay.Core\DnDOverlay.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The send queues and the heartbeat are internal: nothing outside the hub writes to a
         socket. The tests drive them directly all the same, because the two rear queues carry no
         message yet - progress arrives with M2, the transient traffic with M3 - and a queue that
         has never had anything in it is a queue nobody has proven (Part 10). -->
    <InternalsVisibleTo Include="DnDOverlay.Hub.Tests" />
  </ItemGroup>

</Project>
