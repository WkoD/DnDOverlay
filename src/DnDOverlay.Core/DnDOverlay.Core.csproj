<Project Sdk="Microsoft.NET.Sdk">

  <!-- Core knows nobody. Protocol DTOs, scene model, own identifier and geometry types,
       the single scene reducer, ItemToRect, IImageCodec, IAssetSource, ISecretStore.
       net10.0 rather than net10.0-windows: a WPF reference here is a compile error,
       not a test finding (Part 2). -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <!-- Core's first and only package, and it is the framework's own abstraction rather than a
         library: the log provider lives here because BOTH applications need it and Core is the
         one thing they share, and ILogger is the seam the whole of Part 8 is built on. The sink
         itself is hand-written - see Logging/LogFile.cs for why. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

</Project>
