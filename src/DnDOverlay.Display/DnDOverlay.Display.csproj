<Project Sdk="Microsoft.NET.Sdk">

  <!-- The display PC: transparent always-on-top overlay per screen, gestures, tray.
       It deliberately does not reference Imaging - the display only ever sees PNG, JPEG
       and GIF and decodes them with WIC, which keeps its MSI at a few megabytes (Part 5). -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- LibraryImport generates unsafe marshalling code. What remains here are the calls that
         CHANGE our own overlay window - styles and placement; everything the operating system
         is merely asked moved to Platform.Windows (Part 2). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DnDOverlay.Core\DnDOverlay.Core.csproj" />
    <ProjectReference Include="..\DnDOverlay.Platform.Windows\DnDOverlay.Platform.Windows.csproj" />
    <ProjectReference Include="..\DnDOverlay.Transport\DnDOverlay.Transport.csproj" />
  </ItemGroup>

</Project>
