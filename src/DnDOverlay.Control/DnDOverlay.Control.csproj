<Project Sdk="Microsoft.NET.Sdk">

  <!-- The DM surface. Hosts the hub in its own process and is the only owner of the
       campaign folder (Part 2). Published self-contained, because it needs two shared
       frameworks - WindowsDesktop and AspNetCore - and is installed exactly once (Part 9). -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Win32 calls go through LibraryImport (Part 2), and its generated marshalling code is
         unsafe - without this the very first P/P-Invoke fails to compile. Allowed here and
         nowhere else: the five libraries must not call into native code at all, and the
         architecture test enforces that. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- Build order only - the control does not reference their code, and must not: what a helper
       is for is the NAME in the elevation prompt, and calling into it as a library would give
       that up. It does ship them, though, so they have to land beside DnDOverlay.Control.exe:
       that is where the installer puts them, and it is what lets a helper work out from its own
       directory whether it is installed or in a build folder (Part 9). -->
  <ItemGroup>
    <ProjectReference Include="..\DnDOverlay.FirewallAdd\DnDOverlay.FirewallAdd.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\DnDOverlay.FirewallAddAnywhere\DnDOverlay.FirewallAddAnywhere.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\DnDOverlay.FirewallRemove\DnDOverlay.FirewallRemove.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Target Name="CopyFirewallHelpers" AfterTargets="Build">
    <ItemGroup>
      <FirewallHelperFile Include="$(MSBuildThisFileDirectory)..\DnDOverlay.FirewallAdd\bin\$(Configuration)\$(TargetFramework)\DnDOverlay.FirewallAdd.*" />
      <FirewallHelperFile Include="$(MSBuildThisFileDirectory)..\DnDOverlay.FirewallAddAnywhere\bin\$(Configuration)\$(TargetFramework)\DnDOverlay.FirewallAddAnywhere.*" />
      <FirewallHelperFile Include="$(MSBuildThisFileDirectory)..\DnDOverlay.FirewallRemove\bin\$(Configuration)\$(TargetFramework)\DnDOverlay.FirewallRemove.*" />
    </ItemGroup>
    <Copy SourceFiles="@(FirewallHelperFile)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\DnDOverlay.Core\DnDOverlay.Core.csproj" />
    <ProjectReference Include="..\DnDOverlay.Hub\DnDOverlay.Hub.csproj" />
    <ProjectReference Include="..\DnDOverlay.Campaign\DnDOverlay.Campaign.csproj" />
    <ProjectReference Include="..\DnDOverlay.Imaging\DnDOverlay.Imaging.csproj" />
    <ProjectReference Include="..\DnDOverlay.Platform.Windows\DnDOverlay.Platform.Windows.csproj" />
    <!-- The thumbnail draws a name plate and, later, an animation - the same things the table
         draws. It calls the same cascade with the tile's measurements rather than growing a
         second one: the closing run of M3 found the same fault three times in one evening, each
         time a size decided alone instead of asked for (Ortsfrage 9). DecodeSteps expressly does
         NOT apply here - the control never decodes in stages, it takes the thumbnail. -->
    <ProjectReference Include="..\DnDOverlay.Rendering.Windows\DnDOverlay.Rendering.Windows.csproj" />
    <ProjectReference Include="..\DnDOverlay.Transport\DnDOverlay.Transport.csproj" />
  </ItemGroup>

</Project>
